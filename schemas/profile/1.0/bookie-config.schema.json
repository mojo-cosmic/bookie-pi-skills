{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:bookie:schema:profile:1.0:bookie-config",
  "title": "Bookie profile manifest 1.0",
  "description": "The decoded JSON representation of a profile 1.0 bookie.yaml manifest.",
  "type": "object",
  "additionalProperties": false,
  "required": ["profile", "vault", "allowed_concept_types", "policy"],
  "properties": {
    "profile": {
      "type": "string",
      "const": "1.0"
    },
    "vault": {
      "type": "object",
      "additionalProperties": false,
      "required": ["uid", "title"],
      "properties": {
        "uid": {
          "type": "string",
          "pattern": "^VLT-[0-7][0-9A-HJKMNP-TV-Z]{25}(?![\\s\\S])"
        },
        "title": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "allowed_concept_types": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": [
          "Project",
          "Task",
          "Document",
          "Research",
          "Decision",
          "Activity",
          "Evidence",
          "Person"
        ]
      }
    },
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "evidence_roots",
        "exclude",
        "sensitivity",
        "attachment_max_bytes"
      ],
      "properties": {
        "evidence_roots": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/relativePosixPath"
          }
        },
        "exclude": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/constrainedGlob"
          }
        },
        "sensitivity": {
          "type": "object",
          "additionalProperties": false,
          "required": ["classes", "excluded_classes"],
          "properties": {
            "classes": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {
                "$ref": "#/$defs/sensitivityClass"
              }
            },
            "excluded_classes": {
              "type": "array",
              "uniqueItems": true,
              "items": {
                "$ref": "#/$defs/sensitivityClass"
              }
            }
          }
        },
        "attachment_max_bytes": {
          "description": "A positive byte limit validated on the decoded numeric value; source-text precision checks belong to the YAML parser/runtime.",
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        }
      }
    }
  },
  "$defs": {
    "relativePosixPath": {
      "description": "A non-absolute lexical relative POSIX path with non-empty segments and Unicode scalar support, excluding dot segments, colon and percent forms, backslashes, the metacharacters * ? [ ] { } !, C0 controls, DEL, C1 controls, and lone UTF-16 surrogates. Validators must use ECMAScript Unicode regex semantics to accept supplementary scalars; runtimes must treat the value as a literal path rather than a glob.",
      "type": "string",
      "pattern": "^(?![\\s\\S]*(?:^|/)\\.\\.?(?:/|$))[^/\\\\:%*?\\[\\]{}!\\u0000-\\u001F\\u007F-\\u009F\\uD800-\\uDFFF]+(?:/[^/\\\\:%*?\\[\\]{}!\\u0000-\\u001F\\u007F-\\u009F\\uD800-\\uDFFF]+)*(?![\\s\\S])"
    },
    "constrainedGlob": {
      "description": "A relative POSIX glob whose segments are ASCII letters, digits, dot, underscore, and hyphen, or exactly * or **; embedded and extended glob syntax is not accepted.",
      "type": "string",
      "pattern": "^(?!.*(?:^|/)\\.\\.?(?:/|$))(?:[A-Za-z0-9._-]+|\\*|\\*\\*)(?:/(?:[A-Za-z0-9._-]+|\\*|\\*\\*))*(?![\\s\\S])"
    },
    "sensitivityClass": {
      "description": "A lowercase kebab-case sensitivity class token; unknown and unclassified are reserved sentinels.",
      "type": "string",
      "maxLength": 63,
      "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*(?![\\s\\S])",
      "not": {
        "enum": ["unknown", "unclassified"]
      }
    }
  }
}
