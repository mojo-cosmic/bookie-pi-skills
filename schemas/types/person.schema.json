{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:bookie:schema:type:person:1.0",
  "title": "Bookie Person concept 1.0",
  "allOf": [
    {
      "$ref": "urn:bookie:schema:common:1.0"
    },
    {
      "type": "object",
      "properties": {
        "type": {
          "const": "Person"
        },
        "bookie": {
          "type": "object",
          "required": ["created_at"],
          "properties": {
            "uid": {
              "type": "string",
              "pattern": "^PER-"
            },
            "created_at": true
          }
        }
      }
    }
  ]
}
