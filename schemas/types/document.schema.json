{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:bookie:schema:type:document:1.0",
  "title": "Bookie Document concept 1.0",
  "allOf": [
    {
      "$ref": "urn:bookie:schema:common:1.0"
    },
    {
      "type": "object",
      "properties": {
        "type": {
          "const": "Document"
        },
        "bookie": {
          "type": "object",
          "required": ["project", "created_at"],
          "properties": {
            "project": true,
            "created_at": true
          }
        }
      }
    }
  ]
}
